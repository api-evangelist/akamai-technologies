  "info": {
    "_postman_id": "0aa27d48-22b6-4da7-97ba-875fca6c91a0",
    "name": "Akamai Fast Purge (CCU v3) Deletions Invalidations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Akamai Fast Purge (Content Control Utility v3) API for invalidating\nor deleting cached content at the Akamai edge by URL, CP code, or\ncache tag, on either the production or staging network.\nAuthentication uses the Akamai EdgeGrid HMAC-SHA256 scheme. All\nrequests target a per-account hostname under akamaiapis.net.\n\n\nContact Support:\n Name: Akamai Technologies",
      "type": "text/plain"
    }
  }
